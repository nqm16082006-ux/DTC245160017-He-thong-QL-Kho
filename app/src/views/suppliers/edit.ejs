<!DOCTYPE html>
<html lang="vi">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>Sửa nhà cung cấp</title>

<link
    rel="stylesheet"
    href="/css/style.css"
>

</head>


<body>

<header>

<h1>Sửa Nhà cung cấp</h1>

<nav>

<a href="/">Dashboard</a>
<a href="/products">Sản phẩm</a>
<a href="/suppliers">Nhà cung cấp</a>
<a href="/inventory">Nhập / Xuất kho</a>

</nav>

</header>


<main>


<form
    action="/suppliers/<%= supplier.id %>/edit"
    method="POST"
>


<label>Tên nhà cung cấp</label>

<input
    name="name"
    value="<%= supplier.name %>"
    required
>


<label>Số điện thoại</label>

<input
    name="phone"
    value="<%= supplier.phone || '' %>"
>


<label>Email</label>

<input
    name="email"
    type="email"
    value="<%= supplier.email || '' %>"
>


<label>Địa chỉ</label>

<input
    name="address"
    value="<%= supplier.address || '' %>"
>


<button type="submit">

Lưu thay đổi

</button>


<a href="/suppliers/<%= supplier.id %>">

Hủy

</a>


</form>


</main>

</body>

</html>
