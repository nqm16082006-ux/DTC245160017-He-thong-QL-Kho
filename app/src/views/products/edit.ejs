<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Sửa sản phẩm</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>

<header>

    <h1>Sửa sản phẩm</h1>

    <nav>
        <a href="/">Dashboard</a>
        <a href="/products">Sản phẩm</a>
        <a href="/suppliers">Nhà cung cấp</a>
        <a href="/inventory">Nhập / Xuất kho</a>
    </nav>

</header>


<main>

    <form
        action="/products/<%= product.id %>/edit"
        method="POST"
    >

        <label>Tên sản phẩm</label>

        <input
            name="name"
            value="<%= product.name %>"
            required
        >


        <label>SKU</label>

        <input
            name="sku"
            value="<%= product.sku %>"
            required
        >


        <label>Giá</label>

        <input
            type="number"
            name="price"
            min="0"
            step="0.01"
            value="<%= product.price %>"
            required
        >


        <label>Nhà cung cấp</label>

        <select name="supplier_id">

            <option value="">
                -- Không có --
            </option>


            <% suppliers.forEach(supplier => { %>

                <option
                    value="<%= supplier.id %>"

                    <%= String(product.supplier_id) ===
                        String(supplier.id)
                        ? "selected"
                        : "" %>
                >

                    <%= supplier.name %>

                </option>

            <% }) %>

        </select>


        <p>
            <strong>Tồn kho:</strong>
            <%= product.quantity %>
        </p>

        <p>
            Tồn kho không được sửa trực tiếp.
            Hãy sử dụng chức năng Nhập/Xuất kho.
        </p>


        <button type="submit">
            Lưu thay đổi
        </button>


        <a href="/products/<%= product.id %>">
            Hủy
        </a>

    </form>

</main>

</body>

</html>
