<!DOCTYPE html>
<html lang="vi">

<head>

<meta charset="UTF-8">

<title>
Sản phẩm
</title>

<link
    rel="stylesheet"
    href="/css/style.css"
>

</head>

<body>

<header>

<h1>
Quản lý Sản phẩm
</h1>

<nav>

<a href="/">
Dashboard
</a>

<a href="/products">
Sản phẩm
</a>

<a href="/suppliers">
Nhà cung cấp
</a>

<a href="/inventory">
Nhập / Xuất kho
</a>

</nav>

</header>


<main>

<h2>Thêm sản phẩm</h2>


<form
    action="/products/add"
    method="POST"
>

<input
    name="name"
    placeholder="Tên sản phẩm"
    required
>

<input
    name="sku"
    placeholder="Mã SKU"
    required
>

<input
    name="price"
    type="number"
    min="0"
    step="0.01"
    placeholder="Giá"
    required
>


<select
    name="supplier_id"
>

<option value="">
-- Nhà cung cấp --
</option>

<% suppliers.forEach(supplier => { %>

<option
    value="<%= supplier.id %>"
>
    <%= supplier.name %>
</option>

<% }) %>

</select>


<button type="submit">
Thêm sản phẩm
</button>

</form>


<h2>
Danh sách sản phẩm
</h2>


<table>

<thead>

<tr>

<th>ID</th>
<th>SKU</th>
<th>Tên</th>
<th>Giá</th>
<th>Tồn kho</th>
<th>Nhà cung cấp</th>
<th>Thao tác</th>

</tr>

</thead>


<tbody>

<% products.forEach(product => { %>

<tr>

<td>
<%= product.id %>
</td>

<td>
<%= product.sku %>
</td>

<td>
<%= product.name %>
</td>

<td>
<%= Number(product.price).toLocaleString("vi-VN") %>
</td>

<td>
<strong>
<%= product.quantity %>
</strong>
</td>

<td>
<%= product.supplier_name || "Chưa có" %>
</td>

<td>

<form
    action="/products/delete/<%= product.id %>"
    method="POST"
>

<button
    class="danger"
    type="submit"
>
Xóa
</button>

</form>

</td>

</tr>

<% }) %>

</tbody>

</table>

</main>

</body>

</html>
